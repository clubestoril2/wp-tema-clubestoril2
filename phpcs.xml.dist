<?xml version="1.0"?>
<ruleset name="Club Deportivo Estoril II">
    <description>Estilo PSR-12 y reglas de seguridad de WordPress para el tema.

    Prefijo propio: funciones y variables globales de plantilla ce_*, clases en el
    espacio de nombres ClubEstoril2. La regla PrefixAllGlobals de WPCS no se usa
    porque exige prefijos de al menos tres letras.</description>

    <file>.</file>
    <exclude-pattern>/vendor/*</exclude-pattern>
    <exclude-pattern>/.phan/*</exclude-pattern>

    <arg name="extensions" value="php"/>
    <arg name="cache" value=".phpcs-cache"/>
    <arg name="colors"/>
    <arg value="sp"/>

    <config name="minimum_wp_version" value="6.6"/>

    <!-- Estilo: PSR-12. -->
    <rule ref="PSR12">
        <!-- functions.php e inc/ declaran funciones y registran ganchos en el mismo fichero:
             es la forma habitual de un tema de WordPress. -->
        <exclude name="PSR1.Files.SideEffects.FoundWithSymbols"/>
    </rule>

    <!-- Seguridad de WordPress: escapado de salida, nonces y entrada saneada. -->
    <rule ref="WordPress.Security"/>
    <!-- src/ no imprime nada: sus excepciones son errores de programación, no salida HTML. -->
    <rule ref="WordPress.Security.EscapeOutput.ExceptionNotEscaped">
        <exclude-pattern>/src/*</exclude-pattern>
    </rule>
    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.DB.SlowDBQuery"/>

    <!-- Internacionalización con el text domain del tema. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="clubestoril2"/>
            </property>
        </properties>
    </rule>

    <rule ref="WordPress.WP.GlobalVariablesOverride"/>
    <rule ref="WordPress.WP.EnqueuedResources"/>
    <rule ref="WordPress.WP.DeprecatedFunctions"/>
</ruleset>
