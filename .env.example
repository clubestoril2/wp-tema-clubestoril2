# Zona horaria por defecto
TZ=Europe/Madrid

# Extensiones PHP para las herramientas de calidad (contenedores «instalacion» y «pruebas»)
php_extensiones="mbstring intl xml curl zip"

# WordPress local (solo desarrollo; valores de prueba)
WP_PUERTO=8080
WP_URL=http://localhost:8080
WP_BD_NOMBRE=wordpress
WP_BD_USUARIO=wordpress
WP_BD_CLAVE=wordpress-local
WP_ADMIN_USUARIO=admin
WP_ADMIN_CLAVE=estoril-local
WP_ADMIN_CORREO=admin@clubestoril2.test
